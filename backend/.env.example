# Core — all features work without any API keys (heuristic fallbacks)
OPENAI_API_KEY=
USE_LLM=false
OPENAI_MODEL=gpt-4o-mini

# Optional: local transcription for uploads (pip install openai-whisper)
WHISPER_MODEL=base

# Rendering: set false to force simulated renders even if ffmpeg exists
SIMULATED_RENDER=true

# Database (SQLite default; swap to postgresql://... for pgvector later)
DATABASE_URL=sqlite:///./data/creatorai.db

# Frontend origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
